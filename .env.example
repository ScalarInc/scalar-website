# Copy to .env and fill in. The contact API (api/) reads this file.

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend authenticates senders by DNS, so MAIL_FROM must be an address at a
# domain verified in the Resend dashboard — a gmail.com address will not work.
# Until you verify a domain, onboarding@resend.dev is the only usable sender,
# and it can ONLY deliver to the address that owns the Resend account.
MAIL_FROM="Scalar <onboarding@resend.dev>"
MAIL_TO=you@example.com

# Confirmation email to whoever submitted the form. Requires a verified domain;
# stays off automatically while MAIL_FROM still points at resend.dev, so it is
# safe to leave this true once you have set a real sender.
AUTOREPLY_ENABLED=false

# Read the client IP from X-Forwarded-For. Correct behind the Next.js rewrite;
# turn off if this service is ever exposed directly, since the header is
# spoofable when no proxy you control sets it.
TRUSTED_PROXY=true

# Per client IP.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_S=900

# Floor on time-to-submit, in seconds. Submissions faster than this are dropped.
MIN_SUBMIT_SECONDS=2.5

# Where Next.js proxies /api/contact. Use the literal IP, not localhost: Node
# resolves localhost to ::1 first on Windows, and uvicorn on 0.0.0.0 is not
# listening on IPv6.
API_ORIGIN=http://127.0.0.1:8000
